[sound_system]

music={
"type": "solo"
}
effects={
"default": true,
"simultaneous_sounds": 3,
"type": "simultaneous"
}
voice={
"type": "sequential"
}

[filter]

filter="virtual_dmd"
columns=120
rows=45
hardness=5
spacing=2

